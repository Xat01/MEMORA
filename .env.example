# =============================================================================
# MEMORA Configuration
# Copy to .env and customize: cp .env.example .env
# All settings can also be set via environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Obsidian Vault Path (optional — auto-discovered if not set)
# -----------------------------------------------------------------------------
# Absolute path to your Obsidian vault (the folder containing .obsidian/)
# Linux/macOS: VAULT_PATH=/home/user/Documents/MyVault
# Windows:     VAULT_PATH=C:\Users\user\Documents\MyVault
# Leave empty for automatic discovery.
VAULT_PATH=

# -----------------------------------------------------------------------------
# Storage Paths (relative to project root or absolute)
# -----------------------------------------------------------------------------
CHROMA_PATH=./data/chromadb
SQLITE_PATH=./data/memora.db

# -----------------------------------------------------------------------------
# Embedding Provider
# -----------------------------------------------------------------------------
# Options: 'ollama' (default, local), 'openai' (any OpenAI-compatible API),
#          or a fully-qualified Python class name for custom providers.
EMBEDDING_PROVIDER=ollama

# --- Ollama (default) ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_HOST=http://localhost:11434

# --- OpenAI-compatible (uncomment to use) ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-your-key-here
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Other OpenAI-compatible services ---
# Together AI:
#   EMBEDDING_API_BASE=https://api.together.xyz/v1
# Fireworks:
#   EMBEDDING_API_BASE=https://api.fireworks.ai/inference/v1
# Azure OpenAI:
#   EMBEDDING_API_BASE=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# Local (vLLM, text-embeddings-inference, LiteLLM, LocalAI):
#   EMBEDDING_API_BASE=http://localhost:8000/v1
#   EMBEDDING_API_KEY=     (leave empty for no auth)

# --- Custom provider ---
# EMBEDDING_PROVIDER=mypackage.embeddings.MyProvider
# (must subclass memora.embeddings.base.EmbeddingProvider)

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
DEFAULT_SEARCH_K=10
HYBRID_RRF_K=60

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8080

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/memora.log
