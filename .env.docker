# MEMORA Docker Environment Configuration Template
# Copy this file to .env and customize for your deployment.
# DO NOT COMMIT ACTUAL SECRETS OR CREDENTIALS.

# =========================================================================
# REQUIRED: Obsidian Vault Path
# =========================================================================
# Windows Docker Desktop: Use /host_mnt/c/Users/username/vault or similar
# Linux/macOS: Use absolute path /home/username/vault or /mnt/vault
# The vault must contain a .obsidian/ directory.
VAULT_PATH=C:/Users/sa595/Desktop/Cybersecurity-.-/MY Cyb

# =========================================================================
# Ollama Configuration (Explicit - No Auto-Detection)
# =========================================================================
# Valid values: "host" (default) or "container"
# - "host": Connects to Ollama on host machine via Docker Desktop gateway
# - "container": Connects to containerized Ollama service (requires --profile ollama)
OLLAMA_MODE=host

# Primary Ollama endpoint (set based on OLLAMA_MODE above)
# Host mode default: http://host.docker.internal:11434 (Docker Desktop)
# Container mode default: http://ollama:11434 (Compose service DNS)
OLLAMA_HOST=http://host.docker.internal:11434

# Fallback Ollama endpoint for cross-validation
# Host mode fallback: http://ollama:11434
# Container mode fallback: http://host.docker.internal:11434
OLLAMA_HOST_FALLBACK=http://ollama:11434

# =========================================================================
# Embedding Configuration
# =========================================================================
# Embedding model name (must be available in Ollama)
EMBEDDING_MODEL=nomic-embed-text

# Embedding dimensions (must match model output)
# nomic-embed-text: 768
# mxbai-embed-large: 1024
# all-minilm: 384
EMBEDDING_DIMENSIONS=768

# =========================================================================
# Storage Paths (Container Internal - Usually Unchanged)
# =========================================================================
# ChromaDB persistence directory
CHROMA_PATH=/data/chromadb

# SQLite database path
SQLITE_PATH=/data/memora.db

# =========================================================================
# MCP HTTP Server Configuration
# =========================================================================
# Transport protocol: stdio or http
MCP_TRANSPORT=http

# HTTP bind address and port
MCP_HOST=0.0.0.0
MCP_PORT=8080

# =========================================================================
# Logging Configuration
# =========================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (container internal)
LOG_FILE=/logs/memora.log

# =========================================================================
# Optional: Chunking Configuration
# =========================================================================
# Token chunk size for splitting (100-2000)
CHUNK_SIZE=512

# Token overlap between chunks (0-200)
CHUNK_OVERLAP=50

# =========================================================================
# Optional: Search Configuration
# =========================================================================
# Default number of search results (1-100)
DEFAULT_SEARCH_K=10

# Reciprocal Rank Fusion constant (1-200)
HYBRID_RRF_K=60